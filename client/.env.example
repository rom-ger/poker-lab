# PeerJS Cloud (по умолчанию 0.peerjs.com)
# VITE_PEERJS_HOST=0.peerjs.com
# VITE_PEERJS_PORT=443
# VITE_PEERJS_SECURE=true

# Metered TURN — https://dashboard.metered.ca → TURN Server → Add Credential
# «Show ICE Servers Array» → username + password (password = VITE_TURN_CREDENTIAL)
VITE_TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
VITE_TURN_USERNAME=вставьте_username_из_дашборда
VITE_TURN_CREDENTIAL=вставьте_password_из_дашборда
